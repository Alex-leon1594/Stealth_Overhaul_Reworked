-- Stealth Overhaul: silent takedowns and corpse hiding
-- by xcvb

corpses = {}
local hide_timer = {}
local last_update = 0
local takedown_cd = 0
local corpse_cleanup_timer = 0  -- Timestamp (ms) of the last corpse-registry cleanup

local function alive(obj)
	if not obj or (type(obj) ~= "userdata" and type(obj) ~= "table") then return false end
	if not (IsStalker(obj) or IsMonster(obj)) then return false end
	local ok, res = pcall(function() return obj:alive() end)
	return ok and res
end

function is_corpse_hidden(obj)
	local c = corpses[obj:id()]
	return c and c.hidden == true
end

local function on_eval_danger(npc, flags)
	-- Universal guard, active no matter which xr_danger won the VFS (vanilla,
	-- this mod's copy, or the AlifeTactics runtime patch): a hidden corpse
	-- never triggers a danger reaction.
	if not (flags and flags.ret_value ~= false and npc) then return end
	if not (IsStalker(npc) and alive(npc)) then return end
	local ok, danger = pcall(function() return npc:best_danger() end)
	if not (ok and danger and danger:type() == danger_object.entity_corpse) then return end
	local ok2, obj = pcall(function() return danger:object() end)
	if ok2 and obj and is_corpse_hidden(obj) then
		flags.ret_value = false
	end
end

-- fires the same callbacks as "Stealth Kill Detection Fix" so quests, loot
-- and statistics see the kill, without NPCs aggroing the actor
local function notify_silent_kill(victim)
	local weapon = db.actor and db.actor:active_item()
	pcall(SendScriptCallback, "npc_on_death_callback", victim, weapon)
	pcall(SendScriptCallback, "npc_on_silent_kill_callback", victim, db.actor, weapon, true)
	last_s_killed = victim:id()  -- Track the last silent kill as a global (Stealth Kill Detection Fix reads it)
	pcall(function()
		local stats = game_statistics.actor_statistics
		if not stats["silent_kills"] then
			stats["silent_kills"] = {count = 0, rank = 5, rept = 0}
		end
		game_statistics.increment_statistic("silent_kills")
	end)
end

local function try_takedown()
	local tg = time_global()
	if tg < takedown_cd then return end

	local wpn = db.actor:active_item()
	if not (wpn and IsWeapon(wpn) and IsMelee(wpn)) then return end
	if not IsMoveState('mcCrouch') then return end

	local ap = db.actor:position()
	local fwd = db.actor:direction()
	local best
	local best_dot = -2

	for id in pairs(stealth_noise.online_npcs) do
		local npc = level and level.object_by_id(id)
		if npc and IsStalker(npc) and alive(npc) and npc:id() ~= AC_ID then
			if npc:position():distance_to_sqr(ap) <= 4.84 then
				if not npc:see(db.actor) and not npc:best_enemy() then
					local st = db.storage[id]
					local vma = visual_memory_manager.alarm_boost and visual_memory_manager.alarm_boost[id]
					if not (st and st.danger_flag) and not (vma and vma > tg) then
						local dir = vector():set(npc:position()):sub(ap)
						local ml = dir:magnitude()
						if ml > 0.01 then
							dir:mul(1 / ml)
							local dot = fwd:dotproduct(dir)
							local npc_dir = vector():set(npc:direction())
							local behind_dot = npc_dir:dotproduct(dir)
							if dot > best_dot and behind_dot > -0.2 then
								best_dot = dot
								best = npc
							end
						end
					end
				end
			end
		end
	end

	if not best or best_dot < 0.55 then return end

	-- Capture the victim's squad id BEFORE the kill: after death the squad
	-- handle is no longer readable, and the "nervous squad" persistence
	-- (visual_memory_manager) needs it while the victim is still alive.
	local victim_squad_id = nil
	if get_object_squad then
		local ok, squad = pcall(function() return get_object_squad(best) end)
		if ok and squad then
			local ok2, sid = pcall(function() return squad:id() end)
			if ok2 then victim_squad_id = sid end
		end
	end

	local kill_ok = pcall(function() best:kill(db.actor) end)
	if not kill_ok then
		return
	end
	corpses[best:id()] = {hidden = false, t = time_global()}
	takedown_cd = tg + 1000
	news_manager.send_tip(db.actor, "Silent takedown", 0, nil, 1500)
	notify_silent_kill(best)
	local victim_name = best:character_name() or best:name()
	local victim_comm = character_community(best) or "unknown"
	local victim_rank = (ranks and ranks.get_obj_rank_name and ranks.get_obj_rank_name(best)) or "unknown"
	stealth_log.log(string.format("Silent takedown: %s (ID %d, %s, %s) eliminated with %s", victim_name, best:id(), victim_comm, victim_rank, wpn and wpn:section() or "knife"), "TAKEDOWN")
	if victim_squad_id and visual_memory_manager and visual_memory_manager.mark_squad_nervous then
		visual_memory_manager.mark_squad_nervous(victim_squad_id, time_global())  -- Squad gets a temporary perception bonus
	end
end

function on_weapon_fired()
	if not (stealth_mcm.get_config("takedown") and db.actor and db.actor:alive()) then return end
	local wpn = db.actor:active_item()
	if not (wpn and IsWeapon(wpn) and IsMelee(wpn)) then return end
	try_takedown()
end

function stealth_takedown_update()
	if not (db.actor and db.actor:alive()) then return end
	local tg = time_global()
	if tg - last_update < 200 then return end
	last_update = tg

	if not stealth_mcm.get_config("hide_corpse") then return end

	if tg - corpse_cleanup_timer > 30000 then          -- Prune the corpse registry once every 30 s
		corpse_cleanup_timer = tg
		local sim = alife()
		for id, c in pairs(corpses) do
			if not (sim and sim:object(id)) then corpses[id] = nil end
		end
	end

	if not IsMoveState('mcCrouch') then
		for k in pairs(hide_timer) do hide_timer[k] = nil end
		return
	end

	local ap = db.actor:position()
	local fwd = db.actor:direction()
	local handled = {}

	local function process_corpse(npc)
		if not (npc and IsStalker(npc) and not alive(npc)) then return end
		local id = npc:id()
		local c = corpses[id]
		if not (c and c.hidden) then
			local pos = npc:position()
			if pos:distance_to_sqr(ap) <= 4.0 then
				local dir = vector():set(pos):sub(ap)
				local ml = dir:magnitude()
				if ml > 0.01 and fwd:dotproduct(dir:mul(1 / ml)) > 0.75 then
					handled[id] = true
					hide_timer[id] = (hide_timer[id] or 0) + 0.2
					if hide_timer[id] >= 1.5 then
						c = c or {}
						c.hidden = true
						c.t = tg
						corpses[id] = c
						hide_timer[id] = nil
						pcall(function() npc:set_corpse_ready(false) end)
						pcall(function() npc:set_visible(false) end)
						news_manager.send_tip(db.actor, "Corpse hidden", 0, nil, 1500)
						stealth_log.log(string.format("Corpse hidden: NPC %d (%s) at distance %.1fm", id, npc:character_name() or npc:name(), math.sqrt(pos:distance_to_sqr(ap))), "TAKEDOWN")
					end
				end
			end
		end
	end

	if level and level.iterate_nearest then
		level.iterate_nearest(ap, 3.0, process_corpse)
	else
		for id, st in pairs(db.storage) do
			if id ~= AC_ID and st and st.object then
				process_corpse(st.object)
			end
		end
	end

	for k in pairs(hide_timer) do
		if not handled[k] then hide_timer[k] = nil end
	end
end

function save_state(m_data)
	-- Persist the hidden-corpse registry into the save (survives save/load;
	-- the engine keeps the corpse invisible, this table keeps the danger
	-- suppression working after a reload).
	m_data.stealth_corpses = corpses
end

function load_state(m_data)
	-- Restore the hidden-corpse registry after a save/load: keep only entries
	-- whose corpse object still exists (the engine cleaned up the rest), and
	-- re-apply the invisibility flags so a restored corpse stays hidden.
	corpses = {}
	local saved = m_data and m_data.stealth_corpses
	if not (saved and type(saved) == "table") then return end
	local restored = 0
	for id, c in pairs(saved) do
		local obj = level and level.object_by_id(id)  -- Resolve the corpse object
		if obj and IsStalker(obj) and not alive(obj) then                -- Object still exists and is a corpse
			corpses[id] = c                            -- Restore the hidden entry
			restored = restored + 1
			pcall(function() obj:set_corpse_ready(false) end)  -- Not lootable (safe call)
			pcall(function() obj:set_visible(false) end)       -- Invisible in the world (safe call)
		end
	end
	if restored > 0 then
		stealth_log.log("Corpse hiding: restored " .. restored .. " hidden corpse(s) from save state", "SYSTEM")
	end
end

function on_game_start()
	RegisterScriptCallback("actor_on_update", stealth_takedown_update)
	RegisterScriptCallback("actor_on_weapon_fired", on_weapon_fired)
	RegisterScriptCallback("npc_on_eval_danger", on_eval_danger)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
end

-- Export local functions for unit testing
if _G._TEST_MODE then
	return {
		alive = alive,
		notify_silent_kill = notify_silent_kill,
		try_takedown = try_takedown
	}
end
